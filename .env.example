# Copy these into your Vercel project → Settings → Environment Variables

# Stripe secret key (starts with sk_live_ or sk_test_) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Set to true after enabling Stripe Tax for the states where you collect sales tax
STRIPE_AUTOMATIC_TAX=false

# Optional: Formspree form ID for the contact & newsletter forms (https://formspree.io)
VITE_FORMSPREE_ID=
